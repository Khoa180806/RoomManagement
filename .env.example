POSTGRES_DB=room_management
POSTGRES_USER=room_management
POSTGRES_PASSWORD=change-me-for-local-only
BACKEND_PORT=8081
FRONTEND_PORT=8080

# Telegram nhắc hạn (Task 6): tạo bot qua @BotFather, lấy chat ID qua @userinfobot.
# Bỏ trống nếu chưa cấu hình; ứng dụng sẽ ghi cảnh báo khi khởi động và API trả
# 409 TELEGRAM_NOT_CONFIGURED khi gửi tin nhắn thử.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SĐT chủ nhà dùng để đăng nhập (OTP gửi qua Telegram). Bắt buộc khi dùng app.
OWNER_PHONE=

# Chỉ dùng khi cần chạy thử job nhắc hạn ngoài giờ (mặc định 09:00 hằng ngày).
# APP_REMINDERS_CRON=0 0 9 * * *
